# ── IBM watsonx.ai credentials ────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# IBM Cloud API key — create at https://cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=your-ibm-cloud-api-key-here

# watsonx.ai project ID — found in your watsonx.ai project settings
WATSONX_PROJECT_ID=your-watsonx-project-id-here

# watsonx.ai regional endpoint — us-south is the default
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ── Feature flags ─────────────────────────────────────────────────────────────
# Set to "true" to enable live watsonx.ai scoring.
# Set to "false" (or leave unset) to use rule-based scoring only (mock mode).
WATSONX_ENABLED=false

# ── v2.4.0 Authentication ─────────────────────────────────────────────────────
# SIMULATE_SSO=true   → mock login using scripts/test-users.csv (default for dev)
# SIMULATE_SSO=false  → real IBM w3id OIDC (requires CLIENT_ID + CLIENT_SECRET)
SIMULATE_SSO=true

# Session secret — change to a long random string in production
SESSION_SECRET=change-me-to-a-long-random-string-in-production

# ── Real IBM w3id OIDC (only needed when SIMULATE_SSO=false) ─────────────────
# Obtain these by registering the app in IBM's w3id identity portal.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ISSUER_URL=https://w3id.alpha.sso.ibm.com/oidc/endpoint/default
