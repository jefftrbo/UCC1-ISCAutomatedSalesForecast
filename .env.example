# ── IBM watsonx.ai credentials ────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# IBM Cloud API key — create at https://cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=your-ibm-cloud-api-key-here

# watsonx.ai project ID — found in your watsonx.ai project settings
WATSONX_PROJECT_ID=your-watsonx-project-id-here

# watsonx.ai regional endpoint — us-south is the default
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ── Feature flags ─────────────────────────────────────────────────────────────
# Set to "true" to enable live watsonx.ai scoring.
# Set to "false" (or leave unset) to use rule-based scoring only (mock mode).
WATSONX_ENABLED=false
